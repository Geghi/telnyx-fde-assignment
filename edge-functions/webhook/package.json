{
  "name": "webhook",
  "version": "0.1.0",
  "description": "Bright Smile Dental — dynamic variables webhook with KV + Stateful Actor",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/@telnyx/edge-runtime/package.json';try{const d=JSON.parse(fs.readFileSync(p,'utf8'));d.sideEffects=false;fs.writeFileSync(p,JSON.stringify(d,null,2)+'\\n');console.log('patched @telnyx/edge-runtime sideEffects=false')}catch(e){console.log('skip sideEffects patch:',e.message)}\""
  },
  "dependencies": {
    "@telnyx/edge-runtime": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
