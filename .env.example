# Telnyx API key — Bearer auth for the Assistants + MCP-servers REST API.
# Create one at https://portal.telnyx.com/#/app/api-keys
# setup.ts reads this (never committed; .env.* is gitignored).
TELNYX_API_KEY=

# Assistant ID — printed by `npm run setup` after creating the assistant.
# Used by chat.ts, trace.ts, and eval/runner.ts.
ASSISTANT_ID=assistant-c7d08f46-9786-461d-ad19-85d1b6f96994

# Live edge function URLs (printed by `telnyx-edge ship`).
MCP_SERVER_URL=https://mcp-server-5d976a49-d.telnyxcompute.com
WEBHOOK_URL=https://webhook-03381a02-a.telnyxcompute.com

# Front-desk number the Transfer node dial-transfers to (E.164).
FRONT_DESK_NUMBER=+12175551234

# Password for GET /callbacks (front-desk list of call-back requests).
# Must match the edge secret: `telnyx-edge secrets add STAFF_TOKEN <value>`.
# Used by scripts/list-callbacks.sh. Keep the real value in .env.local only.
STAFF_TOKEN=

# Dial-in number bought via `npm run buy-number` (or the portal).
# `buy-number.ts` writes this; `setup.ts` reads it and binds it to the assistant.
ASSISTANT_PHONE_NUMBER=

# Optional overrides for `npm run buy-number`. Defaults: US local, voice, no area code.
# BUY_COUNTRY_CODE=US
# BUY_NUMBER_TYPE=local
# BUY_AREA_CODE=
# BUY_FEATURES=voice

# LLM model used by eval runner for the judge (optional, defaults to Kimi-K2.6)
JUDGE_MODEL=moonshotai/Kimi-K2.6
